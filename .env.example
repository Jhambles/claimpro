# --- New feature integrations (all optional — each has a safe fallback) ---

# File uploads (claim evidence): create a Blob store in your Vercel project
# dashboard (Storage tab) and copy the token. Without this, uploads return a
# clear 503 error instead of failing silently.
BLOB_READ_WRITE_TOKEN=""

# Chatbot ("Clai"): an Anthropic API key enables real AI answers. Without it,
# the widget still works using a rule-based FAQ fallback (with emoji).
ANTHROPIC_API_KEY=""

# Payments — GCash & Maya via PayMongo (https://dashboard.paymongo.com):
PAYMONGO_SECRET_KEY=""
# Payments — PayPal (https://developer.paypal.com):
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
# Without the above payment keys, checkout uses an in-app sandbox screen at
# /pay/[id] so the full flow (status, notifications) is still testable.

# Renewal reminder cron (see vercel.json): Vercel auto-sends this as a Bearer
# token when triggering the scheduled job. Set the same value here.
CRON_SECRET=""
