// ClaimsPro data model â€” cloud PostgreSQL (Neon / Supabase) via Prisma ORM

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CLIENT
  PROCESSOR
  ADMIN
}

enum PolicyCategory {
  MEDICAL
  AUTOMOTIVE
  HOMEOWNERS
}

enum ClaimStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(CLIENT)
  createdAt     DateTime @default(now())

  claims        Claim[]        @relation("ClaimOwner")
  processed     Claim[]        @relation("ClaimProcessor")
  loasGenerated Loa[]          @relation("LoaGeneratedBy")
  notifications Notification[]
  chatMessages  ChatMessage[]
  payoutPreference PayoutPreference?

  @@map("users")
}

model Claim {
  id          String         @id @default(cuid())
  referenceId String         @unique
  category    PolicyCategory
  estimate    Decimal        @db.Decimal(12, 2)
  status      ClaimStatus    @default(PENDING)

  userId      String
  user        User           @relation("ClaimOwner", fields: [userId], references: [id])

  processorId String?
  processor   User?          @relation("ClaimProcessor", fields: [processorId], references: [id])

  documents   Document[]
  loa         Loa?
  payments    Payment[]
  decisions   ClaimDecision[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("claims")
}

model Document {
  id         String   @id @default(cuid())
  claimId    String
  claim      Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  mimeType   String
  sizeBytes  Int
  uploadedAt DateTime @default(now())

  @@map("documents")
}

model Loa {
  id          String   @id @default(cuid())
  claimId     String   @unique
  claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  content     String   @db.Text
  // Locked in at generation time â€” the letter's printed text names this
  // provider, so every later QR/checkout regeneration for this claim must
  // keep using it too, even if the claimant's Settings preference changes
  // afterward. Without this, the letter could say "via GCash" while the QR
  // silently started pointing somewhere else.
  provider    PaymentProvider @default(GCASH)
  generatedAt DateTime @default(now())

  generatedById String
  generatedBy   User   @relation("LoaGeneratedBy", fields: [generatedById], references: [id])

  @@map("letters_of_authorization")
}

enum NotificationType {
  STATUS_UPDATE
  RENEWAL
  PAYMENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  claimId   String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

enum PaymentProvider {
  GCASH
  MAYA
  PAYPAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id          String          @id @default(cuid())
  claimId     String
  claim       Claim           @relation(fields: [claimId], references: [id], onDelete: Cascade)
  provider    PaymentProvider
  amount      Decimal         @db.Decimal(12, 2)
  status      PaymentStatus   @default(PENDING)
  providerRef String?

  // Only populated when provider = BANK_TRANSFER. Bank transfers aren't
  // processed through a gateway like GCash/Maya are â€” staff verify the
  // deposit manually against these details, so there's no redirect checkout.
  bankName      String?
  accountName   String?
  accountNumber String?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("payments")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("chat_messages")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String
  actorRole String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}

// A claimant's saved default payout method â€” set once from the claimant
// Settings page, so they don't have to re-enter bank/provider details on
// every single claim. Purely a convenience default: the claim payout flow
// itself still lets them pick a different provider per claim if they want.
model PayoutPreference {
  id            String          @id @default(cuid())
  userId        String          @unique
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider      PaymentProvider
  bankName      String?
  accountName   String?
  accountNumber String?
  updatedAt     DateTime        @updatedAt

  @@map("payout_preferences")
}

// One row per staff decision (verify / approve / reject) on a claim, with the
// reason the staff member entered in the confirmation pop-up. Kept as history
// rather than a single column so a claim that was verified and later rejected
// shows both reasons.
model ClaimDecision {
  id            String      @id @default(cuid())
  claimId       String
  claim         Claim       @relation(fields: [claimId], references: [id], onDelete: Cascade)
  status        ClaimStatus
  reason        String      @db.Text
  decidedById   String?
  decidedByName String
  decidedByRole String
  createdAt     DateTime    @default(now())

  @@index([claimId, createdAt])
  @@map("claim_decisions")
}
